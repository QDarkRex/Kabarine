# name=path pairs; the paths are inside the watchdog container (see compose.yml volumes)
WATCH=media-bot=/watch/media-bot/heartbeat.json
STALE_MINUTES=15
LANGUAGE=en

# Where alerts go — pick ONE.
# A channel webhook:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Or any bot token. Alone it DMs that bot application's owner; or set a channel/user.
BOT_TOKEN=
# ALERT_CHANNEL_ID=
# ALERT_USER_ID=
